# ==========================================
# EduPulse LMS - Root .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit .env files)
.env
.env.local
.env.*.local
*.env
!*.env.example
venv/
.venv/
env/

# Database 
/backend/data/
/backend/*.db
*.mv.db
*.trace.db

# Maven & Java Build Outputs
**/target/
*.class
*.jar
.classpath
.settings/
.project
.mvn/
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Frontend & Flutter Build Outputs
**/node_modules/
**/dist/
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
.npm
.yarn/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Editor Specific Files
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary and Scratch Directories
tmp/
temp/
scratch/
.system_generated/
