# ==========================================
# EduChain Frontend - API Configuration
# ==========================================

# Local API Base URL (default for desktop/web/mobile development):
API_BASE_URL_LOCAL=http://localhost:5002/api
# Android Emulator Local URL:
API_BASE_URL_ANDROID_EMULATOR=http://10.0.2.2:5002/api

# Production Render API Base URL:
API_BASE_URL_PROD=https://two6-10-02-educhain.onrender.com/api
API_ROOT_URL_PROD=https://two6-10-02-educhain.onrender.com

# Flutter Run / Build Command Examples:
# 1. Target Localhost (default):
#    flutter run -d chrome
# 2. Target Production via environment toggle:
#    flutter run -d chrome --dart-define=APP_ENV=production
# 3. Target Production via explicit URL:
#    flutter run -d chrome --dart-define=API_BASE_URL=https://two6-10-02-educhain.onrender.com/api
# 4. Target Production release build:
#    flutter build web --release --dart-define=API_BASE_URL=https://two6-10-02-educhain.onrender.com/api
