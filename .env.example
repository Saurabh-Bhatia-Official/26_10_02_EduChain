# Local PostgreSQL defaults are provided by backend application.properties.
# Uncomment to override them for local development; set your own password only
# if your local PostgreSQL server requires one. Do not commit populated .env files.
# DATABASE_URL=jdbc:postgresql://localhost:5432/edlearndb
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=
SERVER_PORT=5000

# Production PostgreSQL (set real values in the deployment environment only):
# DATABASE_URL=jdbc:postgresql://<host>:5432/<database>?sslmode=require
# DATABASE_USERNAME=<username>
# DATABASE_PASSWORD=<password>

# Cloudinary media storage (optional for local startup; required for uploads):
# CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
# Alternatively, provide CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, and CLOUDINARY_API_SECRET.

# Use the same random secret on every backend replica (at least 32 characters)
EDLEARN_AUTH_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
EDLEARN_LEAVE_SECOND_APPROVAL=true

# Integration tests only: use a dedicated disposable PostgreSQL database, never production.
# TEST_DATABASE_URL=jdbc:postgresql://<test-host>:5432/<test-database>?sslmode=require&currentSchema=edlearn
# TEST_DATABASE_USERNAME=<test-username>
# TEST_DATABASE_PASSWORD=<test-password>
