# ==========================================
# LMS - Root Environment Template (.env.example)
# ==========================================

# Backend Configuration
SERVER_PORT=8085

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8085/api/v1
VITE_PORT=5173
VITE_APP_TITLE=LMS
VITE_APP_ENV=development

# Backend PostgreSQL (Neon)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>/<database>?sslmode=require&currentSchema=edlearn
SPRING_DATASOURCE_USERNAME=<database-user>
SPRING_DATASOURCE_PASSWORD=<database-password>

# Optional file storage providers
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
AWS_ENDPOINT_URL_S3=<s3-compatible-endpoint>
AWS_ACCESS_KEY_ID=<access-key>
AWS_SECRET_ACCESS_KEY=<secret-key>
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=edlearn-storage
